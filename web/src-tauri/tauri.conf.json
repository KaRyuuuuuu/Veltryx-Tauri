{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veltryx Control",
  "version": "0.1.2",
  "identifier": "veltryx.karyuu.be",
  "build": {
    "beforeDevCommand": "npm run dev:full",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Veltryx Control",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://veltryx.karyuu.be/updates/latest.json"
      ],
      "pubkey": "RWQrRJqX2uRZ4EhABTClefodyisPlJSxIO4wPkwoNfy3HrovqniZ1Doy",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
